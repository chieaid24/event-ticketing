      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(event_ticketing_http_requests_total[5m]))",
          "legendFormat": "requests"
        }
      ],
      "title": "Request rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(event_ticketing_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(event_ticketing_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx rate"
        }
      ],
      "title": "Server error rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
