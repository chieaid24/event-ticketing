{
  "name": "@event-ticketing/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "db:seed": "prisma db seed --config prisma.config.ts",
    "lint": "eslint src",
    "test": "vitest run src",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "ioredis": "5.11.1",
    "prisma": "7.9.0",
    "tsx": "4.23.1"
  }
}
