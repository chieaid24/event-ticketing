generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  CUSTOMER @map("customer")
  ADMIN    @map("admin")

  @@map("platform_role")
}

enum UserStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  DISABLED  @map("disabled")

  @@map("user_status")
}

enum MembershipRole {
  OWNER         @map("owner")
  ADMIN         @map("admin")
  EVENT_MANAGER @map("event_manager")
  FINANCE       @map("finance")
  SCANNER       @map("scanner")
  VIEWER        @map("viewer")

  @@map("membership_role")
}

enum MembershipStatus {
  INVITED @map("invited")
  ACTIVE  @map("active")
  REMOVED @map("removed")

  @@map("membership_status")
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION @map("email_verification")
  PASSWORD_RESET     @map("password_reset")

  @@map("auth_token_purpose")
}

enum VenueSectionKind {
  ASSIGNED          @map("assigned")
  GENERAL_ADMISSION @map("general_admission")

  @@map("venue_section_kind")
}

enum OutboxStatus {
  PENDING     @map("pending")
  PROCESSING  @map("processing")
  COMPLETED   @map("completed")
  DEAD_LETTER @map("dead_letter")

  @@map("outbox_status")
}

enum EventStatus {
  DRAFT        @map("draft")
  PUBLISHED    @map("published")
  SALES_PAUSED @map("sales_paused")
  POSTPONED    @map("postponed")
  CANCELLED    @map("cancelled")
  COMPLETED    @map("completed")
  ARCHIVED     @map("archived")

  @@map("event_status")
}

enum TicketTypeKind {
  ASSIGNED          @map("assigned")
  GENERAL_ADMISSION @map("general_admission")

  @@map("ticket_type_kind")
}

enum EventSeatStatus {
  AVAILABLE @map("available")
  HELD      @map("held")
  SOLD      @map("sold")
  BLOCKED   @map("blocked")

  @@map("event_seat_status")
}

model User {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String                   @unique @db.VarChar(320)
  passwordHash      String?                  @map("password_hash") @db.VarChar(255)
  platformRole      PlatformRole             @default(CUSTOMER) @map("platform_role")
  status            UserStatus               @default(PENDING)
  emailVerifiedAt   DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships       OrganizationMembership[]
  invitedMembership OrganizationMembership[] @relation("MembershipInviter")
  sessions          Session[]
  authTokens        AuthToken[]
  auditLogs         AuditLog[]               @relation("AuditActor")

  @@map("users")
}

model Session {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash     String    @map("csrf_token_hash") @db.Char(64)
  deviceSummary     String    @default("unknown") @map("device_summary") @db.VarChar(160)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

model AuthToken {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    AuthTokenPurpose
  tokenHash  String           @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@map("auth_tokens")
}

model Organization {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String                   @db.VarChar(160)
  slug        String                   @unique @db.VarChar(80)
  version     Int                      @default(1)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships OrganizationMembership[]
  auditLogs   AuditLog[]
  venues      Venue[]
  events      Event[]

  @@map("organizations")
}

model Venue {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String         @db.VarChar(120)
  description    String?        @db.VarChar(400)
  version        Int            @default(1)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sections       VenueSection[]
  events         Event[]

  @@unique([organizationId, name])
  @@map("venues")
}

model VenueSection {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId    String            @map("venue_id") @db.Uuid
  name       String            @db.VarChar(80)
  kind       VenueSectionKind
  gaCapacity Int?              @map("ga_capacity")
  position   Int
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  venue      Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  rows       VenueSeatingRow[]

  @@unique([venueId, name])
  @@map("venue_sections")
}

model VenueSeatingRow {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectionId String       @map("section_id") @db.Uuid
  label     String       @db.VarChar(12)
  position  Int
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  section   VenueSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  seats     VenueSeat[]

  @@unique([sectionId, label])
  @@map("venue_rows")
}

model VenueSeat {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rowId      String          @map("row_id") @db.Uuid
  label      String          @db.VarChar(12)
  x          Int
  y          Int
  accessible Boolean         @default(false)
  companion  Boolean         @default(false)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  row        VenueSeatingRow @relation(fields: [rowId], references: [id], onDelete: Cascade)

  @@unique([rowId, label])
  @@map("venue_seats")
}

model AuditLog {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  action         String        @db.VarChar(120)
  targetType     String        @map("target_type") @db.VarChar(80)
  targetId       String?       @map("target_id") @db.Uuid
  detail         Json          @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)], map: "audit_logs_org_created_idx")
  @@map("audit_logs")
}

model OrganizationMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(INVITED)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  joinedAt       DateTime?        @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy      User?            @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("organization_memberships")
}

model OutboxSchedule {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String        @unique @db.VarChar(120)
  topic           String        @db.VarChar(120)
  payload         Json
  aggregateType   String?       @map("aggregate_type") @db.VarChar(80)
  aggregateId     String?       @map("aggregate_id") @db.Uuid
  intervalSeconds Int           @map("interval_seconds")
  nextRunAt       DateTime      @map("next_run_at") @db.Timestamptz(6)
  maxAttempts     Int           @default(8) @map("max_attempts")
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  events          OutboxEvent[]

  @@index([nextRunAt, id], map: "outbox_schedules_due_idx")
  @@map("outbox_schedules")
}

model OutboxEvent {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic            String                @db.VarChar(120)
  payload          Json
  aggregateType    String?               @map("aggregate_type") @db.VarChar(80)
  aggregateId      String?               @map("aggregate_id") @db.Uuid
  deduplicationKey String?               @unique @map("deduplication_key") @db.VarChar(200)
  scheduleId       String?               @map("schedule_id") @db.Uuid
  scheduledFor     DateTime?             @map("scheduled_for") @db.Timestamptz(6)
  status           OutboxStatus          @default(PENDING)
  availableAt      DateTime              @default(now()) @map("available_at") @db.Timestamptz(6)
  attemptCount     Int                   @default(0) @map("attempt_count")
  maxAttempts      Int                   @default(8) @map("max_attempts")
  lockedBy         String?               @map("locked_by") @db.VarChar(200)
  lockedUntil      DateTime?             @map("locked_until") @db.Timestamptz(6)
  lastErrorCode    String?               @map("last_error_code") @db.VarChar(80)
  completedAt      DateTime?             @map("completed_at") @db.Timestamptz(6)
  deadLetteredAt   DateTime?             @map("dead_lettered_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  schedule         OutboxSchedule?       @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  handlerReceipt   OutboxHandlerReceipt?

  @@unique([scheduleId, scheduledFor])
  @@index([availableAt, createdAt, id], map: "outbox_events_ready_idx")
  @@index([lockedUntil, id], map: "outbox_events_expired_claim_idx")
  @@index([deadLetteredAt, id], map: "outbox_events_dead_letter_idx")
  @@map("outbox_events")
}

model OutboxHandlerReceipt {
  eventId     String      @id @map("event_id") @db.Uuid
  handlerName String      @map("handler_name") @db.VarChar(120)
  completedAt DateTime    @default(now()) @map("completed_at") @db.Timestamptz(6)
  event       OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("outbox_handler_receipts")
}

model Event {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String       @map("organization_id") @db.Uuid
  venueId             String       @map("venue_id") @db.Uuid
  title               String       @db.VarChar(140)
  description         String?      @db.VarChar(2000)
  status              EventStatus  @default(DRAFT)
  timezone            String       @default("UTC") @db.VarChar(64)
  currency            String       @default("USD") @db.Char(3)
  startsAt            DateTime?    @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime?    @map("ends_at") @db.Timestamptz(6)
  salesStartAt        DateTime?    @map("sales_start_at") @db.Timestamptz(6)
  salesEndAt          DateTime?    @map("sales_end_at") @db.Timestamptz(6)
  holdDurationSeconds Int          @default(600) @map("hold_duration_seconds")
  refundPolicy        String?      @map("refund_policy") @db.VarChar(2000)
  mediaUrl            String?      @map("media_url") @db.VarChar(2048)
  publishedAt         DateTime?    @map("published_at") @db.Timestamptz(6)
  version             Int          @default(1)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venue               Venue        @relation(fields: [venueId], references: [id], onDelete: Restrict)
  ticketTypes         TicketType[]
  seats               EventSeat[]

  @@index([organizationId, status])
  @@map("events")
}

model TicketType {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String         @map("event_id") @db.Uuid
  name        String         @db.VarChar(80)
  kind        TicketTypeKind
  sectionName String         @map("section_name") @db.VarChar(80)
  priceMinor  Int            @map("price_minor")
  feeMinor    Int            @default(0) @map("fee_minor")
  capacity    Int?
  position    Int
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seats       EventSeat[]

  @@unique([eventId, name])
  @@map("ticket_types")
}

model EventSeat {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String          @map("event_id") @db.Uuid
  ticketTypeId String          @map("ticket_type_id") @db.Uuid
  sectionName  String          @map("section_name") @db.VarChar(80)
  rowLabel     String          @map("row_label") @db.VarChar(12)
  seatLabel    String          @map("seat_label") @db.VarChar(12)
  x            Int
  y            Int
  accessible   Boolean         @default(false)
  companion    Boolean         @default(false)
  priceMinor   Int             @map("price_minor")
  status       EventSeatStatus @default(AVAILABLE)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType   TicketType      @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@unique([eventId, sectionName, rowLabel, seatLabel])
  @@index([eventId, status])
  @@map("event_seats")
}
