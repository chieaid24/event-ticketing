# local development only, do not use outside local containers
DATABASE_URL=postgresql://event_ticketing:example-local-only-password@127.0.0.1:5432/event_ticketing?schema=public
REDIS_URL=redis://127.0.0.1:6379
WAITING_ROOM_TOKEN_SECRET=replace-with-at-least-32-random-characters
WAITING_ROOM_ADMISSION_CAPACITY=100
WAITING_ROOM_HEARTBEAT_TTL_SECONDS=60
WAITING_ROOM_LEASE_TTL_SECONDS=300
WAITING_ROOM_TOKEN_TTL_SECONDS=1800
API_BASE_URL=http://127.0.0.1:4000
API_HOST=127.0.0.1
API_PORT=4000
API_DEPENDENCY_TIMEOUT_MS=2000
API_COOKIE_SECURE=false
API_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# load-test only; api refuses to start with this set in production
API_RATE_LIMITS_DISABLED=false
SESSION_IDLE_TTL_SECONDS=86400
SESSION_ABSOLUTE_TTL_SECONDS=2592000
LOG_LEVEL=info
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Event Ticketing <no-reply@example.test>
WEB_BASE_URL=http://127.0.0.1:3000
VERIFICATION_TOKEN_TTL_SECONDS=86400
RESET_TOKEN_TTL_SECONDS=1800
WORKER_SHUTDOWN_TIMEOUT_MS=10000
WORKER_OUTBOX_BATCH_SIZE=10
WORKER_OUTBOX_LEASE_MS=30000
WORKER_OUTBOX_POLL_INTERVAL_MS=1000
WORKER_OUTBOX_RETRY_BASE_MS=1000
WORKER_OUTBOX_RETRY_MAXIMUM_MS=300000
# stripe test keys stay outside vcs
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=whsec_local_development_only
#STRIPE_SECRET_KEY=sk_test_replace_me
#STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
OPS_ALERT_EMAIL=ops@example.test
# source for shared remote build cache
TURBO_API=http://127.0.0.1:9080
TURBO_TEAM=team_event_ticketing
TURBO_TOKEN=example-local-only-turbo-token
